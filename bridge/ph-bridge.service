[Unit]
Description=pH bridge fra mosquitto til Vercel
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=mbierfreund
WorkingDirectory=/home/mbierfreund/farm-dashboard/bridge
EnvironmentFile=/home/mbierfreund/farm-dashboard/bridge/.env
ExecStart=/home/mbierfreund/bridge-venv/bin/python /home/mbierfreund/farm-dashboard/bridge/ph_bridge.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
